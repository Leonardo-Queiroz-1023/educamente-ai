# Supabase — use os valores do painel Project Settings > API
# A URL e a chave anon/publishable podem ser usadas no cliente com RLS habilitado.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Somente para rotinas confiáveis executadas no servidor.
# NUNCA exponha esta chave no frontend, GitHub ou arquivos públicos.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Agente de IA (pasta agent/). Copie estas linhas para agent/.env.local.
# A chave do provedor de IA fica SÓ no servidor do agente, nunca no front-end.
# AI_PROVIDER: "anthropic" (Claude) ou "gemini" (chave do Google AI Studio).
AI_PROVIDER=anthropic
AI_PROVIDER_API_KEY=
# Em branco usa o padrão do provedor (claude-opus-5-5 ou gemini-3.8-flash).
AI_MODEL=
# Origens do front-end autorizadas a chamar o agente (separadas por vírgula).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
