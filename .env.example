# Supabase — use os valores do painel Project Settings > API
# A URL e a chave anon/publishable podem ser usadas no cliente com RLS habilitado.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Somente para rotinas confiáveis executadas no servidor.
# NUNCA exponha esta chave no frontend, GitHub ou arquivos públicos.
SUPABASE_SERVICE_ROLE_KEY=
