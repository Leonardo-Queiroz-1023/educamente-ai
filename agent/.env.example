# Copie para agent/.env.local e preencha. Nunca versione o arquivo preenchido.

# Provedor de IA: "anthropic" (Claude) ou "gemini" (Google AI Studio).
AI_PROVIDER=anthropic
# Chave da API do provedor. Fica só no servidor.
#   anthropic: Console da Anthropic > API Keys
#   gemini:    https://aistudio.google.com/apikey
AI_PROVIDER_API_KEY=
# Modelo. Em branco usa o padrão do provedor (anthropic: claude-opus-5-5; gemini: gemini-3.8-flash).
AI_MODEL=

# Mesmos valores públicos do supabase-config.js (URL e chave anon/publishable).
# O backend NÃO usa a service_role: cada consulta roda com o token do professor e passa pelo RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origens do front-end autorizadas a chamar a API (separadas por vírgula).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Modo demonstração (MVP): permite usar a IA SEM LOGIN, sobre os dados do navegador.
# Só para apresentações: a rota fica aberta (com limite por IP e checagem de origem) e gasta sua cota de IA.
DEMO_MODE=false
