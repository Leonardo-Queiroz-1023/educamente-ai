# Copie para agent/.env.local e preencha. Nunca versione o arquivo preenchido.

# Provedor de IA. Hoje: "anthropic" (Claude). A camada src/lib/ai permite trocar no futuro.
AI_PROVIDER=anthropic
# Chave da API do provedor (Console da Anthropic > API Keys). Fica só no servidor.
AI_PROVIDER_API_KEY=
# Modelo usado pelo agente.
AI_MODEL=claude-opus-5-5

# Mesmos valores públicos do supabase-config.js (URL e chave anon/publishable).
# O backend NÃO usa a service_role: cada consulta roda com o token do professor e passa pelo RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origens do front-end autorizadas a chamar a API (separadas por vírgula).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
